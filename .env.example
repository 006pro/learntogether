# Copy to .env and fill in. Never commit .env.

# "development" or "production"
APP_ENV=development

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

DATABASE_URL=sqlite:///./learntogether.db

# Google OAuth 2.0 client (Web application) from Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional. Defaults to <current host>/auth/callback. Set it when behind a proxy.
OAUTH_REDIRECT_URI=

# Development-only sign-in by display name, for when no Google credentials are available.
# Only takes effect with APP_ENV=development. The app refuses to start if this is true in production.
DEV_AUTH_ENABLED=false
